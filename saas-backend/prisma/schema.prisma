generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  papers    Paper[]
  createdAt DateTime @default(now())
}

model Book {
  id           String   @id @default(uuid())
  title        String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  format       String   // PDF, DOCX
  content      String   // Extracted text
  chapters     String?  // Optional chapter breakdown (JSON string)
  createdAt    DateTime @default(now())
}

model Paper {
  id            String   @id @default(uuid())
  title         String
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  duration      Int      // in minutes
  maxMarks      Int
  config        String   // Store the generation config (JSON string)
  content       String   // The generated questions structured (JSON string)
  pdfUrl        String?
  positiveMarks Float?
  negativeMarks Float?
  isPublished   Boolean  @default(false)
  assignments   ExamAssignment[]
  createdAt     DateTime @default(now())
}

model RegistrationCode {
  id          String   @id @default(uuid())
  code        String   @unique
  isValid     Boolean  @default(true)
  maxUses     Int      @default(1)
  currentUses Int      @default(0)
  students    Student[]
  createdAt   DateTime @default(now())
}

model Student {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique // College Registration Number
  password           String
  name               String
  year               String
  section            String
  mlNumber           String
  fatherName         String
  mobileNumber       String
  status             String   @default("ACTIVE") // ACTIVE, SUSPENDED, BLOCKED
  validUntil         DateTime?
  codeId             String?
  code               RegistrationCode? @relation(fields: [codeId], references: [id])
  assignments        ExamAssignment[]
  createdAt          DateTime @default(now())
}

model ExamAssignment {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  paperId     String
  paper       Paper    @relation(fields: [paperId], references: [id])
  status      String   @default("PENDING") // PENDING, STARTED, COMPLETED
  marks       Float?
  reportData  String?  // JSON containing detailed report
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([studentId, paperId])
}
